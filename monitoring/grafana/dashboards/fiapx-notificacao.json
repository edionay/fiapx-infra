{
  "uid": "fiapx-notificacao",
  "title": "FIAP X - Notificação",
  "tags": ["fiapx", "notificacao"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Notificações por segundo (por resultado)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (resultado) (rate(notificacoes_processadas_total{service=\"fiapx-notificacao\"}[5m]))",
          "legendFormat": "{{resultado}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total de notificações por resultado",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (resultado) (notificacoes_processadas_total{service=\"fiapx-notificacao\"})",
          "legendFormat": "{{resultado}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memória residente",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_resident_memory_bytes{service=\"fiapx-notificacao\"}",
          "legendFormat": "rss"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latência do event loop (p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_eventloop_lag_p99_seconds{service=\"fiapx-notificacao\"}",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
